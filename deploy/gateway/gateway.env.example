# Copy to gateway.env and fill in. gateway.env is gitignored — keep real
# hostnames and every key out of the repository.
#
#   cp gateway.env.example gateway.env && $EDITOR gateway.env
#   docker compose --env-file gateway.env up -d

# --- upstreams -----------------------------------------------------------
# The two vLLM replicas, each a 2-node TP=2 instance. Point at each replica's
# HEAD node; the worker node is internal to the replica and is never addressed
# by the gateway.
#
# Deliberately two entries, not one: 2x TP=2 measured ~66% more prefill and
# ~40% more decode throughput than a single 4-node TP=4 instance at the
# concurrency this deployment sees.
REPLICA_A_URL=http://replica-a.internal:8000
REPLICA_B_URL=http://replica-b.internal:8000

# --- client authentication (REQUIRED) ------------------------------------
# Caddy performs this, not smg. smg has no client-facing API key for
# inference: `--api-key` authorizes to the WORKER and
# `--control-plane-api-keys` covers only the management API. Anything that
# can reach smg's port can run inference on it, so smg is never published
# and Caddy is the credential boundary.
#
# One token per person; the name is what appears in the access log, which is
# how "who used what" gets answered. Generate each with:
#
#     openssl rand -hex 32
#
# Add or remove people by editing BOTH this file and the map block in
# caddy/Caddyfile. Revoking is deleting the line and reloading Caddy.
TOKEN_OWNER=
TOKEN_FRIEND_1=
TOKEN_FRIEND_2=

# --- admission -----------------------------------------------------------
# -1 disables smg's rate limiter. Despite the name this flag is NOT a
# concurrency cap: it is a token bucket, and above the limit it REJECTS rather
# than queues. Measured on this deployment, 16 concurrent requests at a limit
# of 8 produced 9 completions and 7 x HTTP 408 within 2 seconds; at -1 the same
# burst is 16/16.
#
# Admission belongs to vLLM, which has a real scheduler and queue. Peak
# throughput is still around concurrency 8 (at 16, aggregate decode drops
# 112.0 -> 97.9 t/s, per-request 20.2 -> 11.6, TTFT 4.3 -> 7.8 s) -- but the
# right response to that is to let requests wait, not to turn them away.
#
# Set a positive value only if you actually need to throttle a caller, and
# read it as "reject above this rate", not "queue above this concurrency".
MAX_CONCURRENT_REQUESTS=-1

# --- timeouts ------------------------------------------------------------
# Cold prefill is silent on the wire until the engine yields its first token:
# measured 89 s at 131K context and 214 s at 260K. Every timeout in the chain
# must exceed that with margin, or healthy long requests get cut.
#
# Ordering matters: smg's timeout should fire FIRST, because it knows what the
# request is doing and can report it properly. Caddy is the outer backstop.
SMG_REQUEST_TIMEOUT_SECS=1800
CADDY_PROXY_TIMEOUT=7200s

# --- listener ------------------------------------------------------------
# 127.0.0.1 keeps the gateway local-only, which is right while testing or when
# something else on this host forwards to it. Set 0.0.0.0 to accept from the
# LAN or from a DDNS front end.
CADDY_BIND=127.0.0.1
CADDY_PORT=8443

# info | debug | warn. smg redacts API keys in its Debug output.
SMG_LOG_LEVEL=info
